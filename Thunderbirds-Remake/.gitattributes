# Normalize line endings: git auto-detects text vs binary for anything not listed below
* text=auto

# ---- Code ----
*.cs            text diff=csharp
*.shader        text
*.hlsl          text
*.cginc         text
*.json          text
*.md            text

# ---- Unity YAML (project uses Force Text serialization) ----
# Forced to LF so Windows/Mac machines don't produce fake whole-file diffs.
# linguist-generated collapses them in GitHub pull request diffs.
*.unity         text eol=lf linguist-generated
*.prefab        text eol=lf linguist-generated
*.meta          text eol=lf linguist-generated
*.mat           text eol=lf linguist-generated
*.anim          text eol=lf linguist-generated
*.controller    text eol=lf linguist-generated
*.overrideController text eol=lf linguist-generated
*.physicsMaterial2D  text eol=lf linguist-generated
*.inputactions  text eol=lf
*.scenetemplate text eol=lf
# .asset files are left to auto-detection: some (e.g. baked LightingData) are binary even in Force Text mode

# ---- Large binaries -> Git LFS ----
# Images
*.png           filter=lfs diff=lfs merge=lfs -text
*.jpg           filter=lfs diff=lfs merge=lfs -text
*.jpeg          filter=lfs diff=lfs merge=lfs -text
*.psd           filter=lfs diff=lfs merge=lfs -text
*.tga           filter=lfs diff=lfs merge=lfs -text
*.tif           filter=lfs diff=lfs merge=lfs -text
*.exr           filter=lfs diff=lfs merge=lfs -text
*.aseprite      filter=lfs diff=lfs merge=lfs -text
# Audio
*.wav           filter=lfs diff=lfs merge=lfs -text
*.mp3           filter=lfs diff=lfs merge=lfs -text
*.ogg           filter=lfs diff=lfs merge=lfs -text
*.aif           filter=lfs diff=lfs merge=lfs -text
# 3D / video
*.fbx           filter=lfs diff=lfs merge=lfs -text
*.blend         filter=lfs diff=lfs merge=lfs -text
*.mp4           filter=lfs diff=lfs merge=lfs -text
# Fonts / documents
*.ttf           filter=lfs diff=lfs merge=lfs -text
*.otf           filter=lfs diff=lfs merge=lfs -text
*.pdf           filter=lfs diff=lfs merge=lfs -text
