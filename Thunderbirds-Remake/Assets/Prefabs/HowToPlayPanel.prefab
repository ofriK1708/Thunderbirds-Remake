  m_text: '<color=#A884F3>LIGHT</color>  up to 4: either ship

    <color=#3F8CFF>HEAVY</color> 
    up to 8: Atlas only

    <color=#E04040>TOO HEAVY</color>  over 8: no ship


    The
    edge colour shows the class.

    Weight = number of occupied cells.

    A push
    counts the whole chain,

    including blocks resting on top.

    Unsupported
    blocks fall.'
  m_isRightToLeft: 0
